{
  "hyprland/workspaces": {
    "format": "{name}"
  },
  "bluetooth": {
    "format": "󰂲",
    "format-on": "{icon}",
    "format-off": "{icon}",
    "format-connected": "{icon}",
    "format-icons": {
      "on": "󰂯",
      "off": "󰂲",
      "connected": "󰂱"
    },
    "on-click": "blueman-manager",
    "tooltip-format-connected": "{device_enumerate}"
  },
  "clock": {
    "tooltip": false,
    "format": "{:%H:%M  -  %A, %d %m}",
    "interval": 1
  },
  "network": {
    "format-wifi": "󰤢",
    "format-ethernet": "󰈀 ",
    "format-disconnected": "󰤠 ",
    "interval": 5,
    "tooltip-format": "{essid} ({signalStrength}%)",
    "on-click": "nm-connection-editor" // TODO add a network manager
  },
  "cpu": {
    "interval": 2,
    "format": "  {usage}%",
    "on-click": "kitty -e htop"
  },
  "memory": {
    "interval": 5,
    "format": "  {used:0.1f}G/{total:0.1f}G",
    "tooltip-format": "Memory"
  },
  "battery": {
    "interval": 2,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}  {capacity}%",
    "format-full": "{icon}  {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "{icon} {time}",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ]
  },
  "custom/exit": {
    "format": "",
    "tooltip": "Power Menu",
    "on-click": "wlogout",
    "interval": 0
  },
  "custom/screenshot": {
    "format": "󰊓",
    "tooltip-format": "Take Screenshot",
    "on-click": "hyprshot -m region --clipboard-only"
  },
  "custom/savescreenshot": {
    "format": "󰉉",
    "tooltip-format": "Save Screenshot",
    "on-click": "hyprshot -m region -o $HOME/Pictures/Screenshots"
  },
  "custom/pipewire": {
    "exec": "pw-volume status",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "format": "{icon} {percentage}",
    "format-icons": {
      "mute": "󰖁",
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    }
  }
}
