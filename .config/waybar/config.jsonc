{
  // General Settings
  // Position Top
  "margin-top": 8,
  "margin-bottom": 0,
  // Position Bottom
  // "position": "bottom",
  // "margin-top": 0,
  // "margin-bottom": 14,
  "layer": "top",
  "height": 16,
  "margin-left": 6,
  "margin-right": 6,
  "spacing": 0,
  // Load modules
  "include": [
    "~/.config/waybar/modules.jsonc"
  ],
  "modules-left": [
    "custom/appmenu",
    "group/quicklinks",
    "wlr/taskbar",
    "hyprland/window"
  ],
  "modules-center": [
    "clock",
    "hyprland/workspaces"
  ],
  // Modules Right
  "modules-right": [
    "custom/updates",
    "pulseaudio",
    "bluetooth",
    "battery",
    "group/hardware",
    "custom/exit",
    "network"
  ],
  // Group Quicklinks
  "group/quicklinks": {
    "orientation": "horizontal",
    "modules": [
      "custom/firefox"
    ]
  },
  // Group Hardware
  "group/hardware": {
    "orientation": "horizontal",
    "modules": [
      "disk",
      "cpu",
      "memory"
    ]
  }
}
