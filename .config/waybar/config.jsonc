{
  "layer": "top",
  "position": "top",
  "margin-top": 12,
  "margin-right": 16,
  "margin-left": 16,
  "include": [
    "~/.config/waybar/modules.jsonc"
  ],
  // Arrangement
  "modules-left": [
    "memory",
    "cpu",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "custom/screenshot",
    "custom/savescreenshot",
    "wlr/taskbar",
    "bluetooth",
    "network",
    "battery",
    "custom/exit"
  ]
}
